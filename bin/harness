#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

dirs() {
  echo .
  find . -mindepth 1 -maxdepth 3 \( -name node_modules -o -name target -o -name .git -o -name dist \) -prune \
    -o \( -name package.json -o -name Cargo.toml \) -print | xargs -n1 dirname | sed 's|^\./||' | sort -u
}

matches() {
  local pj=$1 d=$2 f
  for f in $(jq -r '.detect[]?' "$pj"); do compgen -G "$d/$f" >/dev/null && return 0; done
  [ -f "$d/package.json" ] || return 1
  jq -e --slurpfile p "$pj" '[.dependencies, .devDependencies] | map(. // {} | keys) | add // []
    | any(. as $k | $p[0].detect_dep // [] | index($k))' "$d/package.json" >/dev/null
}

plan() {
  local name pj d planned=""
  if [[ -n ${1:-} ]]; then
    planned="$1 ."$'\n'
  else
    for pj in "$root"/presets/*/preset.json; do
      name=$(basename "$(dirname "$pj")")
      if [[ $(jq -r '.scope // "root"' "$pj") == root ]]; then
        matches "$pj" . && planned+="$name ."$'\n'
        continue
      fi
      for d in $(dirs); do
        while read -r n pd; do
          [[ $n == "$name" && ( $pd == . || $d == "$pd"/* ) ]] && continue 2
        done <<< "$planned"
        matches "$pj" "$d" && planned+="$name $d"$'\n'
      done
    done
  fi
  for name in $(awk 'NF {print $1}' <<< "$planned" | sort -u); do
    local req; req=$(jq -r '.requires // empty' "$root/presets/$name/preset.json")
    [[ -z $req ]] || grep -q "^$req " <<< "$planned" || planned="$req ."$'\n'"$planned"
  done
  # root-scoped presets first, so layers can extend their config
  local scope
  for scope in root dir; do
    while read -r name d; do
      if [[ -n $name && $(jq -r '.scope // "root"' "$root/presets/$name/preset.json") == "$scope" ]]; then echo "$name $d"; fi
    done <<< "$planned"
  done
}

add() {
  if [ -e "$2" ]; then echo "skip $2 (exists)"; else mkdir -p "$(dirname "$2")"; cp "$1" "$2"; echo "add  $2"; fi
}

init() {
  local entries; entries=$(plan "${1:-}")
  [ -n "$entries" ] || { echo "no preset matches; see: harness list" >&2; exit 1; }

  for f in "$root"/core/hooks/*.sh; do add "$f" ".claude/hooks/$(basename "$f")"; done

  local s=.claude/settings.json
  if grep -qs lint-changed.sh "$s"; then
    echo "skip $s hooks (present)"
  else
    [ -e "$s" ] || echo '{}' > "$s"
    jq -s '.[1].hooks as $h | .[0] | reduce ($h | keys[]) as $k (.; .hooks[$k] = ((.hooks[$k] // []) + $h[$k]))' \
      "$s" "$root/core/settings.json" > "$s.tmp" && mv "$s.tmp" "$s"
    echo "hook $s"
  fi

  local edits='[]' checks='[]' runs="" name d pj pre dest
  while read -r name d; do
    pj="$root/presets/$name/preset.json"
    pre=""; [[ $d == . ]] || pre="cd $d && "
    echo "-- $name ($d)"
    if [ -d "$root/presets/$name/files" ]; then
      while read -r f; do
        dest=${f#./}; [[ $d == . ]] || dest="$d/$dest"
        add "$root/presets/$name/files/$f" "$dest"
      done < <(cd "$root/presets/$name/files" && find . -type f)
    fi
    edits=$(jq --arg pre "$pre" --arg d "$d" --argjson e "$edits" '$e + [.edit // empty
      | .match = (if $d == "." then .match else "^" + $d + "/.*" + .match end)
      | .lint = $pre + .lint | if .format then .format = $pre + .format else . end]' "$pj")
    checks=$(jq --arg pre "$pre" --argjson c "$checks" '$c + [.check[]? | $pre + .]' "$pj")
    jq -s '.[0] * (.[1].settings // {})' "$s" "$pj" > "$s.tmp" && mv "$s.tmp" "$s"
    if jq -e .oxlint "$pj" >/dev/null && [ -e .oxlintrc.json ]; then
      jq -s '.[1].oxlint as $o | .[0] * ($o | del(.plugins)) | .plugins = ((.plugins // []) + ($o.plugins // []) | unique)' \
        .oxlintrc.json "$pj" > .oxlintrc.tmp && mv .oxlintrc.tmp .oxlintrc.json
    fi
    if jq -e .deps "$pj" >/dev/null; then runs+="run: $pre$(jq -r .deps "$pj")"$'\n'; fi
  done <<< "$entries"

  local t; t=$(mktemp)
  jq -n --argjson e "$edits" --argjson c "$checks" '{edit: $e, check: $c}' > "$t"
  add "$t" .claude/harness.json; rm "$t"

  if grep -qs '^## Testing' CLAUDE.md; then
    echo "skip CLAUDE.md (has ## Testing)"
  else
    { [ -s CLAUDE.md ] && echo; cat "$root/core/CLAUDE.md"; } >> CLAUDE.md
    echo "add  CLAUDE.md ## Testing"
  fi

  printf '%s' "$runs"
}

baseline() {
  [ -f .claude/harness.json ] || { echo "run harness init first" >&2; exit 1; }
  export ROOT=$PWD
  rm -rf .claude/baseline
  mkdir -p .claude/baseline
  local cmd out
  while IFS= read -r cmd; do
    out=$(bash -c "$cmd" 2>&1) && continue
    sed -E 's/[0-9]+/N/g' <<< "$out" | sort > ".claude/baseline/$(printf %s "$cmd" | shasum | cut -c1-12)"
    echo "baselined $(wc -l < ".claude/baseline/$(printf %s "$cmd" | shasum | cut -c1-12)" | tr -d ' ') lines: $cmd"
  done < <(jq -r '.check[]' .claude/harness.json)
}

case ${1:-} in
  init) shift; init "$@" ;;
  baseline) baseline ;;
  list) ls "$root/presets" ;;
  *) echo "usage: harness init [preset] | baseline | list" >&2; exit 1 ;;
esac
